# Copy to .env and fill in. Never commit the real .env — it is git-ignored.

# --- Core ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Public base URL, used to build invite links and media URLs.
PUBLIC_BASE_URL=http://localhost:8080

# --- Database ---
DATABASE_URL=postgres://ping:ping@localhost:5432/ping

# --- Auth ---
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. The two secrets MUST be different, so a stolen
# access token can never be replayed as a refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Media storage ---
# "local" writes to MEDIA_LOCAL_DIR; "s3" uses the S3 settings below.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage
MEDIA_MAX_BYTES=104857600

# S3 / R2 / MinIO — only needed when MEDIA_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (verification and password reset) ---
# Leave EMAIL_DRIVER=console in development: codes are printed to the server log
# instead of being sent, so no provider account is needed to try the app.
EMAIL_DRIVER=console
EMAIL_FROM=no-reply@ping.example
SMTP_URL=

# --- Calls (WebRTC) ---
# Comma-separated ICE server URLs. STUN alone works on most networks; a TURN
# server is required for the ~10-20% behind symmetric NAT.
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Limits ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
